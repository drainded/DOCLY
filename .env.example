# Copia este archivo a ".env" (sin ".example") y completa tus API keys.
# El archivo ".env" nunca debe subirse a git (ver .gitignore).

# Obligatoria — clasificacion semantica (Paso 3 del pipeline).
# Consiguela gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional — fallback cuando Gemini devuelve rate limit (seccion 9).
# Consiguela gratis en: https://console.groq.com/keys
GROQ_API_KEY=

# Opcionales — tienen valores por defecto razonables, descomenta para cambiarlos.
# GEMINI_MODEL=gemini-flash-lite-latest
# GROQ_MODEL=openai/gpt-oss-120b
# MAX_FILE_SIZE_BYTES=52428800
# OUTPUT_DIR=output
# LIBREOFFICE_BIN=libreoffice

# Despliegue (ver el Dockerfile): limites y sesiones.
# MOSTRADOR_DAILY_LIMIT=3                 # documentos por IP y dia UTC (0 = sin limite)
# MOSTRADOR_SESSION_TTL_MINUTES=60        # inactividad tras la que se borra una sesion
# MOSTRADOR_TRUSTED_PROXY_HOPS=auto       # IP real tras un proxy: auto, o un numero de proxies de confianza
# MOSTRADOR_CLIENT_IP_HEADER=cf-connecting-ip # cabecera de IP real si hay un proxy que la sobrescribe (Cloudflare)
# MOSTRADOR_STORAGE_DIR=/tmp/mostrador/storage
