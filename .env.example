# Copia este archivo a ".env" (sin ".example") y completa tus API keys.
# El archivo ".env" nunca debe subirse a git (ver .gitignore).

# Obligatoria — clasificacion semantica (Paso 3 del pipeline).
# Consiguela gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional — fallback cuando Gemini devuelve rate limit (seccion 9).
# Consiguela gratis en: https://console.groq.com/keys
GROQ_API_KEY=

# Opcionales — tienen valores por defecto razonables, descomenta para cambiarlos.
# GEMINI_MODEL=gemini-flash-lite-latest
# GROQ_MODEL=openai/gpt-oss-120b
# MAX_FILE_SIZE_BYTES=52428800
# OUTPUT_DIR=output
# LIBREOFFICE_BIN=libreoffice
